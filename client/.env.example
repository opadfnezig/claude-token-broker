# URL of the broker server.
CTB_SERVER_URL=http://broker.example.com:9990

# Server's pubkey — printed by ./server/deploy.sh after first start, also
# returned in the server's /health response.
CTB_SERVER_PUBKEY=

# How the broker can reach THIS client to push token updates. Must be
# resolvable from the broker host. Typically http://<this-host-ip>:9991/token.
CTB_CALLBACK_URL=http://192.0.2.10:9991/token

# Local listen port (also the callback port).
CTB_CALLBACK_PORT=9991

# Where to write the credentials. Other containers on this host RO-mount
# these paths. The directory must already exist.
CTB_CREDENTIALS_OUT=/var/lib/agentforge-creds

# How often to re-sync as a heartbeat. The broker drops dead subscriptions
# after a few push failures, but if we re-sync we self-heal.
CTB_SYNC_INTERVAL_MS=300000
