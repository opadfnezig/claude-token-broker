# Public port the broker listens on. Clients hit this.
CTB_PORT=9990

# Where the host systemd refresh service writes the mirror. install.sh sets
# this up at /var/lib/claude-token-broker by default.
CTB_MIRROR_DIR=/var/lib/claude-token-broker

# Push tuning (server → client callback).
CTB_PUSH_TIMEOUT_MS=5000
CTB_PUSH_MAX_FAILURES=3
